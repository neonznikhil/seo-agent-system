
<script>
let currentWebsiteId = "";
let currentWebsiteDomain = "";
let websitesList = [];

function toggleTheme(){
  const h=document.documentElement, d=h.getAttribute('data-theme')==='dark';
  h.setAttribute('data-theme', d?'light':'dark');
  document.getElementById('theme-icon').textContent=d?'☀':'☽';
  localStorage.setItem('rf-theme', d?'light':'dark');
}
(function(){
  const s=localStorage.getItem('rf-theme');
  if(s==='dark'){
    document.documentElement.setAttribute('data-theme','dark');
    const i=document.getElementById('theme-icon');
    if(i) i.textContent='☽';
  }
})();

const pageTitles={
  dashboard:'Dashboard', websites:'Websites', content:'Content Studio',
  calendar:'Calendar', backlinks:'Backlinks', 'tech-seo':'Tech SEO',
  monitoring:'Monitoring', brain:'Brand Brain', knowledge:'Knowledge Base',
  memory:'Vector Memory', llms:'LLMs.txt', connectors:'Connectors', wordpress:'WordPress Manager'
};

function switchPage(id, btn){
  document.querySelectorAll('.page-container').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  const p=document.getElementById('page-'+id);
  if(p) p.classList.add('active');
  if(btn) {
    btn.classList.add('active');
  } else {
    const navBtn = document.querySelector(`[onclick*="${id}"]`);
    if(navBtn) navBtn.classList.add('active');
  }
  document.getElementById('topbar-title').textContent=pageTitles[id]||id;

  if(id==='dashboard') loadDashboard();
  if(id==='content') loadContent();
  if(id==='brain') loadBrain();
  if(id==='knowledge') loadKnowledge();
  if(id==='backlinks') loadBacklinks();
  if(id==='tech-seo') loadTechSEO();
  if(id==='monitoring') loadMonitoring();
  if(id==='memory') loadMemory();
  if(id==='wordpress') loadWordPressPosts();
}

let toastEl=null;
function showToast(msg){
  if(!toastEl){
    toastEl=document.createElement('div');
    toastEl.style.cssText='position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:9px 20px;font-size:10px;text-transform:uppercase;letter-spacing:.07em;z-index:9999;font-family:'IBM Plex Mono',monospace;box-shadow:0 4px 20px rgba(0,0,0,.3);transition:opacity .3s;';
    document.body.appendChild(toastEl);
  }
  toastEl.textContent=msg;
  toastEl.style.opacity='1';
  clearTimeout(toastEl._t);
  toastEl._t=setTimeout(()=>{toastEl.style.opacity='0';},3000);
}

async function apiGet(endpoint){
  try {
    const res = await fetch(endpoint);
    if(!res.ok) throw new Error(`HTTP ${res.status}`);
    return await res.json();
  } catch(err){
    console.error(`API GET error for ${endpoint}:`, err);
    return null;
  }
}

async function apiPost(endpoint, body, headers={}){
  try {
    const res = await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', ...headers },
      body: JSON.stringify(body)
    });
    return await res.json();
  } catch(err){
    console.error(`API POST error for ${endpoint}:`, err);
    return null;
  }
}

async function fetchWebsites(){
  const data = await apiGet('/api/websites');
  const select = document.getElementById('site-select');
  select.innerHTML = '';

  if(data && data.length > 0){
    websitesList = data;
    data.forEach((site, idx) => {
      const opt = document.createElement('option');
      opt.value = site.id;
      opt.textContent = site.domain;
      select.appendChild(opt);
    });
    if(!currentWebsiteId || !data.some(s => s.id === currentWebsiteId)){
      currentWebsiteId = data[0].id;
      currentWebsiteDomain = data[0].domain;
    }
    select.value = currentWebsiteId;
  } else {
    select.innerHTML = '<option value="">No websites found</option>';
  }
  document.getElementById('dash-active-domain').textContent = currentWebsiteDomain || 'Connect a website';
  renderWebsitesPage();
  loadDashboard();
}

function handleSiteSelectChange(el){
  currentWebsiteId = el.value;
  const site = websitesList.find(s => s.id === currentWebsiteId);
  currentWebsiteDomain = site ? site.domain : '';
  document.getElementById('dash-active-domain').textContent = currentWebsiteDomain;
  showToast(`Switched to: ${currentWebsiteDomain}`);
  loadDashboard();
}

function renderWebsitesPage(){
  const container = document.getElementById('websites-list-container');
  if(!container) return;
  if(websitesList.length === 0){
    container.innerHTML = '<div style="padding:24px;text-align:center;color:var(--muted)">No websites connected yet. Add one above!</div>';
    return;
  }
  container.innerHTML = websitesList.map(site => `
    <div class="site-card">
      <div>
        <div class="site-name">${site.domain}</div>
        <div class="site-url">${site.cms_url || 'https://' + site.domain} &nbsp;·&nbsp; <span class="badge badge-green">Active</span></div>
      </div>
      <div class="site-metrics">
        <div><div class="sm-val">Live</div><div class="sm-lbl">Status</div></div>
        <div><div class="sm-val">24/7</div><div class="sm-lbl">Monitoring</div></div>
      </div>
      <div style="display:flex;gap:6px;">
        <button class="btn btn-accent" onclick="selectAndGo('${site.id}', 'content')">Generate Content</button>
        <button class="btn btn-primary" onclick="selectAndGo('${site.id}', 'dashboard')">Dashboard</button>
      </div>
    </div>
  `).join('');
}

function selectAndGo(siteId, page){
  currentWebsiteId = siteId;
  document.getElementById('site-select').value = siteId;
  const site = websitesList.find(s => s.id === siteId);
  if(site) currentWebsiteDomain = site.domain;
  document.getElementById('dash-active-domain').textContent = currentWebsiteDomain;
  switchPage(page);
}

function openAddSiteModal(){ document.getElementById('modal-site').classList.add('active'); }
function closeAddSiteModal(){ document.getElementById('modal-site').classList.remove('active'); }

async function submitNewWebsite(){
  const domain = document.getElementById('site-domain-input').value.trim();
  const cms_url = document.getElementById('site-cms-input').value.trim();
  const niche = document.getElementById('site-niche-input').value.trim();
  if(!domain){ showToast('Please enter a domain name'); return; }

  showToast('Connecting website...');
  const res = await apiPost('/api/websites', {
    domain: domain,
    cms_url: cms_url || `https://${domain}`,
    niche: niche || 'General',
    target_audience: 'Target customer personas'
  });

  closeAddSiteModal();
  showToast(`✓ Connected: ${domain}`);
  await fetchWebsites();
}

async function addWebsiteFromInput(){
  const domain = document.getElementById('new-site-input').value.trim();
  if(!domain){ showToast('Enter domain URL'); return; }
  document.getElementById('site-domain-input').value = domain;
  await submitNewWebsite();
  document.getElementById('new-site-input').value = '';
}
