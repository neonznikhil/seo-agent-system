# ==============================================================================
# RANKFORGE — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Supabase Postgres & pgvector
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# 2. NVIDIA NIM AI Microservices
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key
NIM_LLM_MODEL=meta/llama-3.1-70b-instruct
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# 3. Security & Auth
JWT_SECRET=your-custom-secure-jwt-secret-min-32-characters-long
ENCRYPTION_KEY=your-32-byte-base64-fernet-encryption-key
TOKEN_ENCRYPTION_KEY=your-32-byte-base64-fernet-encryption-key

# 4. Search & Research APIs
SERPER_API_KEY=your-serper-api-key
TAVILY_API_KEY=tvly-your-tavily-api-key

# 5. CMS & WordPress
WP_SITE_URL=https://your-wordpress-site.com
WORDPRESS_USER=your-wp-username
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 6. Schedulers & Networking
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
