
async function loadDashboard(){
  if(!currentWebsiteId) return;

  const content = await apiGet(`/api/content?website_id=${currentWebsiteId}`);
  if(content){
    document.getElementById('kpi-articles').textContent = content.length;
    const pending = content.filter(c => c.status === 'in_progress' || c.status === 'needs_revision' || c.status === 'draft' || c.status === 'pending_approval').length;
    document.getElementById('kpi-pending').textContent = pending;
    document.getElementById('badge-content-count').textContent = content.length;
  }

  const alerts = await apiGet(`/api/monitoring/${currentWebsiteId}/alerts`);
  if(alerts){
    document.getElementById('kpi-alerts').textContent = alerts.length || 0;
    document.getElementById('badge-alerts-count').textContent = alerts.length || 0;
  }

  const memories = await apiGet(`/api/brain/${currentWebsiteId}/memories`);
  if(memories){
    document.getElementById('kpi-memories').textContent = memories.length || 3;
  }

  const activityList = document.getElementById('dash-activity-list');
  if(content && content.length > 0){
    activityList.innerHTML = content.slice(0, 5).map(c => `
      <div class="activity-row">
        <div class="act-left"><span class="act-sq"></span>Draft: "${c.title}" &nbsp;·&nbsp; <span class="badge ${c.status==='approved'?'badge-green':'badge-amber'}">${c.status}</span></div>
        <span class="act-time">${c.created_at ? new Date(c.created_at).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}) : 'Today'}</span>
      </div>
    `).join('');
  } else {
    activityList.innerHTML = `
      <div class="activity-row"><div class="act-left"><span class="act-sq"></span>Autonomous pipeline standing by for ${currentWebsiteDomain}</div><span class="act-time">Now</span></div>
    `;
  }
}

let activeContentList = [];

async function loadContent(){
  if(!currentWebsiteId) return;
  const tbody = document.getElementById('content-table-body');
  tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:20px;color:var(--muted);">Fetching live proposals from database...</td></tr>';

  const data = await apiGet(`/api/content?website_id=${currentWebsiteId}`);
  if(data && data.length > 0){
    activeContentList = data;
    document.getElementById('badge-content-count').textContent = data.length;
    tbody.innerHTML = data.map(item => {
      const words = item.content ? item.content.split(/\s+/).length : (item.final_scores?.word_count || '—');
      const isApproved = item.status === 'approved' || item.status === 'published';
      const statusBadge = isApproved ? 'badge-green' : (item.status==='in_progress'?'badge-amber':'badge-ink');

      return `
        <tr>
          <td style="font-weight:600;">${item.title}</td>
          <td>${item.keyword || item.topic || '—'}</td>
          <td><span class="badge ${statusBadge}">${item.status}</span></td>
          <td><span style="font-size:9.5px;color:var(--muted);">${item.pipeline_status || 'completed'}</span></td>
          <td>${words}</td>
          <td>
            <div style="display:flex;gap:6px;align-items:center;">
              <span style="color:var(--accent);cursor:pointer;font-size:10px;font-weight:600;" onclick="viewDraft('${item.id}')">View Draft</span>
              ${!isApproved ? `
                <button class="btn btn-accent" style="font-size:8.5px;padding:2px 7px;" onclick="approveBlog('${item.id}')">Approve ✓</button>
              ` : `<span style="color:var(--green);font-size:9px;">Approved</span>`}
            </div>
          </td>
        </tr>
      `;
    }).join('');
  } else {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:24px;color:var(--muted);">No articles generated yet. Click "+ Generate New Article" to start!</td></tr>';
  }
}

function openGenerateModal(){ document.getElementById('modal-generate').classList.add('active'); }
function closeGenerateModal(){ document.getElementById('modal-generate').classList.remove('active'); }

async function startGeneration(){
  const topic = document.getElementById('gen-topic').value.trim();
  const keyword = document.getElementById('gen-keyword').value.trim() || topic;
  if(!topic){ showToast('Please enter an article topic'); return; }

  closeGenerateModal();
  showToast(`🚀 Started 10-phase writer for "${topic}"`);
  document.getElementById('pipeline-status-badge').textContent = 'Writing...';
  document.getElementById('pipeline-step-text').textContent = `Running 10-phase pipeline for "${topic}"`;

  apiPost(`/api/writer/${currentWebsiteId}/generate`, {
    topic: topic,
    primary_keyword: keyword
  }, { 'X-User-Id': 'admin' }).then(res => {
    showToast(`✓ Pipeline completed for "${topic}"!`);
    loadContent();
    document.getElementById('pipeline-status-badge').textContent = 'Ready';
    document.getElementById('pipeline-step-text').textContent = 'Idle';
  });

  setTimeout(loadContent, 3000);
}

function viewDraft(contentId){
  const item = activeContentList.find(c => c.id === contentId);
  if(!item) return;
  document.getElementById('draft-modal-title').textContent = item.title;
  document.getElementById('draft-modal-meta').textContent = `Status: ${item.status.toUpperCase()} | Pipeline: ${item.pipeline_status || 'complete'} | Website: ${currentWebsiteDomain}`;
  document.getElementById('draft-modal-content').textContent = item.content || '(Article drafting in progress or awaiting final assemble step)';
  
  const approveBtn = document.getElementById('draft-modal-approve-btn');
  if(item.status !== 'approved' && item.status !== 'published'){
    approveBtn.style.display = 'block';
    approveBtn.onclick = () => { closeDraftModal(); approveBlog(item.id); };
  } else {
    approveBtn.style.display = 'none';
  }

  document.getElementById('modal-draft').classList.add('active');
}
function closeDraftModal(){ document.getElementById('modal-draft').classList.remove('active'); }

async function approveBlog(blogId){
  showToast('Approving draft and pushing to WordPress...');
  const res = await apiPost(`/api/blogs/approve/${blogId}`, {}, { 'X-User-Id': 'admin' });
  showToast('✓ Draft Approved & Logged!');
  loadContent();
}

async function loadBrain(){
  if(!currentWebsiteId) return;
  const list = document.getElementById('brain-memories-list');
  const memories = await apiGet(`/api/brain/${currentWebsiteId}/memories`);
  
  if(memories && memories.length > 0){
    list.innerHTML = memories.map(m => `
      <div class="mem-item">
        <span class="act-sq"></span>
        <div style="flex:1;">
          <div style="font-size:11px;font-weight:600;color:var(--ink);">${m.title || m.pattern || 'SEO Pattern'}</div>
          <div style="font-size:9.5px;color:var(--muted);margin-top:2px;">${m.content || m.lesson || 'High ranking lift observed across target queries.'}</div>
        </div>
        <span class="badge badge-green">${m.memory_type || 'Success'}</span>
      </div>
    `).join('');
  } else {
    list.innerHTML = `
      <div class="mem-item"><span class="act-sq"></span><div style="flex:1;"><div style="font-size:11px;font-weight:600;">Answer-First Formatting</div><div style="font-size:9.5px;color:var(--muted);">Answers direct questions in first 100 words for featured snippet capture.</div></div><span class="badge badge-green">Default</span></div>
      <div class="mem-item"><span class="act-sq"></span><div style="flex:1;"><div style="font-size:11px;font-weight:600;">Comparison Tables</div><div style="font-size:9.5px;color:var(--muted);">Structured comparison grids increase on-page time by 42%.</div></div><span class="badge badge-green">Default</span></div>
    `;
  }
}

async function saveBrainRule(){
  const title = document.getElementById('new-brain-title').value.trim();
  const content = document.getElementById('new-brain-content').value.trim();
  if(!title || !content){ showToast('Please enter rule title and content'); return; }

  showToast('Saving to Brain...');
  await apiPost('/api/knowledge', {
    website_id: currentWebsiteId,
    title: `[Brain Rule] ${title}`,
    content: content,
    source: 'Human Expert Override',
    tags: ['brain_rule', 'editorial']
  });

  document.getElementById('new-brain-title').value = '';
  document.getElementById('new-brain-content').value = '';
  showToast('✓ Saved rule to Brand Brain!');
  loadBrain();
}

let allKnowledge = [];

async function loadKnowledge(){
  if(!currentWebsiteId) return;
  const list = document.getElementById('knowledge-items-list');
  const items = await apiGet(`/api/knowledge?website_id=${currentWebsiteId}`);
  
  if(items && items.length > 0){
    allKnowledge = items;
    document.getElementById('knowledge-count-badge').textContent = `${items.length} items`;
    list.innerHTML = items.map(k => `
      <div class="mem-item" style="padding:12px;">
        <span class="act-sq"></span>
        <div style="flex:1;">
          <div style="font-size:11px;font-weight:600;color:var(--ink);">${k.title}</div>
          <div style="font-size:10px;color:var(--muted);margin-top:3px;line-height:1.5;">${k.content}</div>
          <div style="font-size:8.5px;color:var(--accent);margin-top:4px;">SOURCE: ${k.source || 'Internal'}</div>
        </div>
      </div>
    `).join('');
  } else {
    list.innerHTML = '<div style="padding:24px;text-align:center;color:var(--muted);">No knowledge items yet. Click "+ Add Knowledge Item" to ingest company context!</div>';
  }
}

function handleKnowledgeSearch(val){
  const term = val.toLowerCase().trim();
  const list = document.getElementById('knowledge-items-list');
  const filtered = allKnowledge.filter(k => k.title.toLowerCase().includes(term) || k.content.toLowerCase().includes(term));
  
  if(filtered.length > 0){
    list.innerHTML = filtered.map(k => `
      <div class="mem-item" style="padding:12px;">
        <span class="act-sq"></span>
        <div style="flex:1;">
          <div style="font-size:11px;font-weight:600;color:var(--ink);">${k.title}</div>
          <div style="font-size:10px;color:var(--muted);margin-top:3px;">${k.content}</div>
        </div>
      </div>
    `).join('');
  } else {
    list.innerHTML = '<div style="padding:20px;text-align:center;color:var(--muted);">No matching knowledge items found.</div>';
  }
}

function openAddKnowledgeModal(){ document.getElementById('modal-knowledge').classList.add('active'); }
function closeAddKnowledgeModal(){ document.getElementById('modal-knowledge').classList.remove('active'); }

async function saveKnowledgeItem(){
  const title = document.getElementById('kn-title').value.trim();
  const content = document.getElementById('kn-content').value.trim();
  const source = document.getElementById('kn-source').value.trim();
  if(!title || !content){ showToast('Enter title and content'); return; }

  showToast('Saving knowledge item...');
  await apiPost('/api/knowledge', {
    website_id: currentWebsiteId,
    title: title,
    content: content,
    source: source || 'Direct Ingestion',
    tags: ['custom_knowledge']
  });

  closeAddKnowledgeModal();
  document.getElementById('kn-title').value = '';
  document.getElementById('kn-content').value = '';
  showToast('✓ Knowledge item saved to database!');
  loadKnowledge();
}
