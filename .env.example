# ==============================================================================
# RANKFORGE — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in the values before running the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE & MULTI-TENANT STORAGE (SUPABASE) [REQUIRED]
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Supabase Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (recommended for backend server operations)
# Or Supabase Anon Key. Required for Postgres & pgvector access.
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Database connection (for direct migrations or pooler)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. NVIDIA NIM AI MICROSERVICES (LLM & EMBEDDINGS) [REQUIRED]
# ------------------------------------------------------------------------------
# NVIDIA NIM API Key (obtain from https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key

# Primary LLM Model for Content Generation & Agent Reasoning
NIM_LLM_MODEL=meta/llama-3.1-70b-instruct
NIM_LLM_FALLBACK=nvidia/nemotron-3-nano-30b-a3b

# Embedding Model for 1536-dim and 1024-dim Vector Operations
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY ENCRYPTION [REQUIRED]
# ------------------------------------------------------------------------------
# JWT Secret Key for signing user auth tokens (minimum 32 characters)
JWT_SECRET=your-custom-secure-jwt-secret-min-32-characters-long

# Fernet Symmetric Encryption Key for storing sensitive WordPress credentials
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-base64-fernet-encryption-key
TOKEN_ENCRYPTION_KEY=your-32-byte-base64-fernet-encryption-key

# ------------------------------------------------------------------------------
# 4. SEARCH ENGINE & REAL-TIME INTELLIGENCE APIS [HIGHLY RECOMMENDED]
# ------------------------------------------------------------------------------
# Serper.dev API Key for Google Search SERP analysis and real-time competitor research
# Obtain from https://serper.dev
SERPER_API_KEY=your-serper-api-key

# Tavily AI Search Key (optional secondary SERP engine)
TAVILY_API_KEY=tvly-your-tavily-api-key

# Crawlee API Key (for proxy web scraping)
CRAWLEE_API_KEY=your-crawlee-api-key

# ------------------------------------------------------------------------------
# 5. CMS & PUBLISHING (WORDPRESS) [OPTIONAL - PER WEBSITE CONFIGURABLE]
# ------------------------------------------------------------------------------
# Default or primary WordPress site URL
WP_SITE_URL=https://your-wordpress-site.com
WORDPRESS_URL=https://your-wordpress-site.com

# WordPress REST API Application Password Credentials
WORDPRESS_USER=your-wp-username
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# WordPress OAuth2 PKCE Connect Credentials (optional for 1-click connect)
WP_OAUTH_CLIENT_ID=your-wp-oauth-client-id
WP_OAUTH_CLIENT_SECRET=your-wp-oauth-client-secret
WP_OAUTH_AUTHORIZE_URL=https://your-wordpress-site.com/oauth/authorize
WP_OAUTH_TOKEN_URL=https://your-wordpress-site.com/oauth/token

# ------------------------------------------------------------------------------
# 6. GOOGLE SEARCH CONSOLE & ANALYTICS [OPTIONAL]
# ------------------------------------------------------------------------------
# Path to Google Service Account JSON file for GSC & GA4 data mining
GSC_CREDENTIALS_PATH=
GA4_CREDENTIALS_PATH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 7. INCIDENT ALERTING & NOTIFICATIONS [OPTIONAL]
# ------------------------------------------------------------------------------
# Slack Incoming Webhook URL for 24/7 critical monitoring alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXX

# Slack Bot Token & App Token (for bidirectional Slack interaction)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Resend API Key for automated email reports and approval notifications
RESEND_API_KEY=re_your-resend-api-key
ALERT_EMAIL_FROM=alerts@rankforge.ai

# ------------------------------------------------------------------------------
# 8. SERVER, CACHE & CORS NETWORKING
# ------------------------------------------------------------------------------
# Redis connection URL for distributed locking & rate limiting
REDIS_URL=redis://localhost:6379/0

# Environment mode: development, staging, production
ENVIRONMENT=development

# Allowed CORS origins (comma-separated, no wildcards in production)
# Example production: ALLOWED_CORS_ORIGINS=https://rankforge-frontend.onrender.com
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Base URLs
# Example production: FRONTEND_URL=https://rankforge-frontend.onrender.com
FRONTEND_URL=http://localhost:3000
# Example production: BACKEND_URL=https://rankforge-backend.onrender.com
BACKEND_URL=http://localhost:8000
