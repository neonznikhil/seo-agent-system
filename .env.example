NVIDIA_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
DUPLICATE_THRESHOLD=0.85
GSC_CREDENTIALS_PATH=
GA4_CREDENTIALS_PATH=
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# WordPress via Application Passwords (primary integration)
# WP Admin > Users > Your User > Application Passwords > New > Copy
WORDPRESS_URL=https://yourwp.com
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
# Optional: override the REST base (defaults to WORDPRESS_URL/wp-json/wp/v2)
WP_API_URL=
# Optional: where connected sites are stored when Supabase is not configured
WP_SITES_FILE=

# WordPress OAuth (optional, only for WordPress.com / OAuth servers)
WP_SITE_URL=https://yourwp.com
WP_OAUTH_CLIENT_ID=xxx_from_wp_oauth_server
WP_OAUTH_CLIENT_SECRET=xxx_from_wp_oauth_server
WP_OAUTH_AUTHORIZE_URL=https://yourwp.com/oauth/authorize
WP_OAUTH_TOKEN_URL=https://yourwp.com/oauth/token
REDIRECT_URI=http://localhost:8000/api/wordpress/oauth/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# For WordPress.com:
# WP_OAUTH_AUTHORIZE_URL=https://public-api.wordpress.com/oauth2/authorize
# WP_OAUTH_TOKEN_URL=https://public-api.wordpress.com/oauth2/token
